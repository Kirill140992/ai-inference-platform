# Local .terraform directories
**/.terraform/*

# .tfstate files (Если вдруг стейт упадет локально)
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# macOS
.DS_Store
**/.DS_Store

# Local Go build output
app/api-go/api-go